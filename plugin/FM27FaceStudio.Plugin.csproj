<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- BepInEx 6 IL2CPP는 게임 폴더의 .NET 6 런타임으로 플러그인을 돌린다.
         그래서 그 .NET 6 파일(refs/net6)을 직접 참조해 만든다. -->
    <TargetFramework>net8.0</TargetFramework>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoCompilerStandardLib>true</NoCompilerStandardLib>
    <AssemblyName>FM27FaceStudio</AssemblyName>
    <RootNamespace>FaceStudio</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- refs/: 게임 설치 폴더에서 가져온 참조용 파일 (BepInEx core·interop, .NET 6). 저장소에 올리지 않는다. -->
  <ItemGroup>
    <Reference Include="refs\*.dll"><Private>false</Private></Reference>
    <Reference Include="refs\net6\*.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
